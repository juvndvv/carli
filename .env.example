# Docker Compose environment. Copy to .env (make setup does it) and adjust.

APP_NAME=Personal
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8180
LOG_LEVEL=info

# Caddy: ":80" serves plain HTTP locally. In production set the domain
# (e.g. app.example.com) for automatic TLS, and APP_BIND=0.0.0.0, APP_PORT=80, APP_HTTPS_PORT=443.
SITE_ADDRESS=:80
APP_BIND=127.0.0.1
APP_PORT=8180
APP_HTTPS_PORT=8543

DB_DATABASE=personal
DB_USERNAME=personal
DB_PASSWORD=personal
DB_HOST_PORT=55440

SESSION_LIFETIME=43200
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:8180,localhost,127.0.0.1:8180

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=personal@localhost

# Push to the iOS app (APNs). Create a key with the Apple Push Notifications service enabled in
# developer.apple.com > Keys and keep the .p8 outside the repo, readable by the container user
# (chmod 644). It is mounted as the Docker secret /run/secrets/apns.p8 in app, worker and scheduler.
# Leave APNS_KEY_ID empty to keep push disabled; notifications still reach the in-app inbox.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=dev.jotade.personal
APNS_PRIVATE_KEY_FILE=/dev/null

SEED_DEMO_USER=false

# Bank sync (F3, Enable Banking). Create an application at https://enablebanking.com (restricted
# mode), register https://<domain>/api/v1/finance/bank/callback as redirect URL and download the
# private key. The key is mounted as the Docker secret /run/secrets/enable_banking.pem in app,
# worker and scheduler; keep it outside the repo and readable by the container user (chmod 644).
# Leave ENABLE_BANKING_APP_ID empty to keep bank sync disabled.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_FILE=/dev/null
# Optional: defaults to ${APP_URL}/api/v1/finance/bank/callback.
ENABLE_BANKING_REDIRECT_URL=

# Subnet for the compose network (the default Docker address pools may be exhausted).
DOCKER_SUBNET=10.231.40.0/24

# Backups: daily pg_dump to ./backups at BACKUP_TIME (Europe/Madrid).
# Set RESTIC_REPOSITORY (and RESTIC_PASSWORD) to also push encrypted snapshots off-site.
BACKUP_TIME=03:00
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_AWS_ACCESS_KEY_ID=
RESTIC_AWS_SECRET_ACCESS_KEY=

# Cloudflare Tunnel (servers with no open ports, e.g. AWS Lightsail). Set COMPOSE_PROFILES=tunnel
# and the tunnel token from Cloudflare Zero Trust -> Networks -> Tunnels. Its public hostname must
# point at http://localhost:${APP_PORT}. Never run the same tunnel on two machines at once.
# COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Database used by "make test-backend".
TEST_DB_DATABASE=personal_test

# Optional prebuilt images (e.g. from GHCR) instead of building locally.
# PHP_IMAGE=ghcr.io/you/personal-app-php:latest
# CADDY_IMAGE=ghcr.io/you/personal-app-caddy:latest
