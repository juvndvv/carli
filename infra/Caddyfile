{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	@hsts {
		protocol https
		not host localhost 127.0.0.1
	}
	header @hsts Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@apiDocs path /docs /docs/*
	header @apiDocs Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"

	@api not path /docs /docs/*
	header @api Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
}

(laravel) {
	request_body {
		max_size 25MB
	}
	rewrite * /index.php
	reverse_proxy {$PHP_FPM_UPSTREAM:app:9000} {
		transport fastcgi {
			root /var/www/html/public
			split .php
		}
	}
}

{$SITE_ADDRESS::80} {
	import security_headers

	encode zstd gzip

	@backend {
		path /api /api/* /sanctum/* /user/* /docs /docs/* /up /broadcasting/*
	}
	@backendAuth {
		path /login /logout /two-factor-challenge /forgot-password /reset-password
		not method GET HEAD
	}

	handle @backend {
		import laravel
	}

	handle @backendAuth {
		import laravel
	}

	handle {
		respond 404
	}
}
